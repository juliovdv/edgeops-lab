{
  "name": "edgeops-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:api": "esbuild apps/api/src/server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/api/server.cjs",
    "build:processor": "esbuild apps/processor/src/runtime.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/processor/index.js",
    "build:dashboard": "vite build --config apps/dashboard/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.base.json"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  }
}
